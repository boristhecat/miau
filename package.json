{
  "name": "miau-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for crypto trade analysis and open-trade monitoring using public market data",
  "type": "module",
  "main": "dist/web.js",
  "scripts": {
    "dev": "tsx src/web.ts",
    "watch": "tsx watch src/web.ts",
    "start": "node dist/web.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anaslaham/talib-wasm": "^4.0.0",
    "axios": "^1.8.4",
    "better-sqlite3": "^11.8.1",
    "openai": "^6.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "nock": "^14.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
